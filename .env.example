# Gemini API key — required for LLM-based product categorization.
# Get one at https://aistudio.google.com/apikey (free tier: 250 req/day).
# Restrict the key to "Generative Language API" only in the Google AI Studio key settings.
GOOGLE_API_KEY=

# Bug report email (Resend). Free tier is 100 emails/day.
# Get an API key at https://resend.com. Without RESEND_API_KEY the report
# button falls back to opening the default mail client with a prefilled email.
RESEND_API_KEY=
REPORT_EMAIL_TO=mcandea@gmail.com
# Used only when RESEND_API_KEY is missing and fallback mailto is triggered.
REPORT_FALLBACK_EMAIL_TO=mcandea@gmail.com
# onboarding@resend.dev works without a verified domain (delivers to the
# inbox tied to your Resend account). Swap to your own domain once verified.
REPORT_EMAIL_FROM=onboarding@resend.dev

# GitHub issue creation for bug reports. Optional — when GITHUB_TOKEN is set,
# every report also files an issue at GITHUB_OWNER/GITHUB_REPO with the same
# content as the email. Token needs `public_repo` scope (or `repo` for private).
# Get one at https://github.com/settings/tokens.
GITHUB_TOKEN=
GITHUB_OWNER=mcandea04
GITHUB_REPO=unified-search
